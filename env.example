PORT=5000
NODE_ENV=development

# Local: mongodb://localhost:27017/content_moderation
# Atlas:  mongodb+srv://<username>:<password>@<cluster>.mongodb.net/content_moderation?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/content_moderation?retryWrites=true&w=majority

# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Gemini API key from Google AI Studio (free tier)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary — image storage. Get these from cloudinary.com dashboard.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

FRONTEND_URL=http://localhost:3000

# Default admin account — created automatically on first server start.
# If this email already exists, it will be promoted to admin (password untouched).
# Leave blank to skip and promote an admin manually instead.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password_min_8_chars
